APP_NAME="Shop Genie"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.your-domain.com

# React storefront URL — payment callbacks bounce back to this app
# (leave empty to use the Laravel Blade storefront pages instead)
STORE_URL=https://your-domain.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shopgenie
DB_USERNAME=shopgenie_user
DB_PASSWORD=CHANGE_ME

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 🤖 Gemini AI Assistant (admin panel)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# 💳 Payment Gateways (also configurable from Admin → API Integration)
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_API_URL=
AAMARPAY_STORE_ID=
AAMARPAY_SIGNATURE_KEY=
AAMARPAY_BASE_URL=
SHURJOPAY_USERNAME=
SHURJOPAY_PASSWORD=

# bKash credentials live in the payment_gateways table (admin panel)

# 🔐 Demo mode — keep false in production
DEMO_MODE=false
