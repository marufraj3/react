# =====================================================================
# React storefront environment
# =====================================================================

# VITE_API_URL: Base URL of the Laravel (PHP) backend, e.g.
#   https://your-domain.com  (serves /api/v1/storefront/* and the /admin panel)
#
# When EMPTY (default), the app runs in DEMO mode using localStorage data.
# When set, the app hydrates from the Laravel REST API and sends orders,
# reviews, complaints and contact messages to it.
VITE_API_URL=""

# Optional: local Laravel dev server target for Vite's dev proxy.
# Leave unset in production.
VITE_BACKEND_PROXY="http://localhost:8000"

# =====================================================================
# Laravel backend environment (see backend/.env.example for full list)
# =====================================================================

# GEMINI_API_KEY: Required for the Gemini AI admin assistant.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where the Laravel app is hosted.
APP_URL="MY_APP_URL"

# STORE_URL: The React storefront URL (set in the Laravel backend too).
# Laravel payment callbacks redirect back to this URL after success/cancel.
STORE_URL=""
